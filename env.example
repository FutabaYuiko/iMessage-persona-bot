# Gemini API Key — get one at https://aistudio.google.com/apikey
LLM_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-3.6-flash-lite. Change this URL if you want to use a different model.
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models/YOUR_MODEL:generateContent

# Photon project credentials — get these from your project console at https://photon.codes
PHOTON_PROJECT_ID=your_photon_project_id_here
PHOTON_PROJECT_SECRET=your_photon_project_secret_here
